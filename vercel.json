{
  "version": 2,
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/",
      "dest": "/api/index"
    },
    {
      "src": "/app.js",
      "dest": "/api/app"
    },
    {
      "src": "/api/clean-csv",
      "dest": "/api/clean-csv"
    },
    {
      "src": "/api/health",
      "dest": "/api/health"
    },
    {
      "src": "/api/hello",
      "dest": "/api/hello"
    },
    {
      "src": "/api/test",
      "dest": "/api/test"
    }
  ]
}