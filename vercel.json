{
  "version": 2,
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/",
      "dest": "/api/index.js"
    },
    {
      "src": "/app.js",
      "dest": "/api/app.js"
    },
    {
      "src": "/api/clean-csv",
      "dest": "/api/clean-csv.js"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.js"
    }
  ]
}